    // 기본 대화 반응 (키워드가 매칭되지 않았을 때 무작위 답변)
    const fallbackResponses = [
      {
        text: "Oh, that's interesting! Tell me more about it. I'm listening!",
        translation: "오, 그거 흥미로운데! 더 자세히 이야기해 줘. 듣고 있어!",
