    let currentGreeting = null;
    let lastSamMessageId = null;
    let currentHints = [];

    // 대화 시작 및 초기화
    function initChat() {
      const chatBox = document.getElementById("chat-box");
      chatBox.innerHTML = ""; // 기존 대화 삭제

      // 10가지 첫 질문 중 하나 랜덤 선택
      const randomIndex = Math.floor(Math.random() * initialGreetings.length);
      currentGreeting = initialGreetings[randomIndex];

      // "타이핑 중..." 1.2초 보여준 뒤 Sam 메시지 출력
      showTypingIndicator();
      setTimeout(() => {
        removeTypingIndicator();
        appendSamMessage(currentGreeting.text, currentGreeting.translation, "first-msg");
        setHints(currentGreeting.hints);
      }, 1200);
    }

    // 화면에 유저 메시지 추가
    function appendUserMessage(text) {
      const chatBox = document.getElementById("chat-box");
      const userBubble = `
        <div class="flex justify-end items-end space-x-2 animate-fade-in self-end max-w-[85%]">
          <div class="bg-blue-500 text-white rounded-2xl rounded-tr-none px-4 py-2.5 text-sm shadow-sm">
            <p>${escapeHTML(text)}</p>
          </div>
        </div>
      `;
      chatBox.insertAdjacentHTML("beforeend", userBubble);
      scrollToBottom();
    }

    // 화면에 Sam의 메시지 추가
    function appendSamMessage(text, translation, messageId) {
      const chatBox = document.getElementById("chat-box");
      const uniqueId = messageId || "msg_" + Date.now();

      const samBubble = `
        <div class="flex items-start space-x-2.5 animate-fade-in max-w-[85%]">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow">
            S
          </div>
          <div class="flex flex-col space-y-1">
            <span class="text-[11px] text-slate-400 font-semibold pl-1">Sam</span>
            <div class="bg-white text-slate-800 rounded-2xl rounded-tl-none px-4 py-2.5 text-sm shadow-sm border border-slate-100 relative group">
              <p class="font-medium">${text}</p>
              
              <div id="trans-${uniqueId}" class="hidden mt-2 pt-2 border-t border-dashed border-slate-200 text-xs text-slate-500 flex items-center space-x-1 bg-slate-50 p-1.5 rounded-lg">
                <span class="font-bold text-indigo-500 text-[10px] uppercase tracking-wider mr-1">Korean</span>
                <span>${translation}</span>
              </div>
            </div>
            
            <button onclick="toggleTranslation('${uniqueId}')" class="self-start text-[10px] text-indigo-500 hover:text-indigo-700 font-medium flex items-center space-x-0.5 px-1.5 py-0.5 rounded hover:bg-indigo-50 transition-colors">
              <i data-lucide="languages" class="w-3 h-3"></i>
              <span>번역 보기/숨기기</span>
            </button>
          </div>
        </div>
      `;
      chatBox.insertAdjacentHTML("beforeend", samBubble);
      lucide.createIcons(); // 아이콘 새로고침
      scrollToBottom();
    }

    // 타이핑 중 표시 애니메이션
    function showTypingIndicator() {
      const chatBox = document.getElementById("chat-box");
      const indicator = `
        <div id="typing-indicator" class="flex items-start space-x-2.5 max-w-[85%]">
          <div class="w-8 h-8 rounded-full bg-slate-300 flex items-center justify-center text-white font-bold text-xs shrink-0">
            S
          </div>
          <div class="flex flex-col space-y-1">
            <span class="text-[11px] text-slate-400 font-semibold pl-1">Sam</span>
            <div class="bg-white rounded-2xl rounded-tl-none px-4 py-3 shadow-sm border border-slate-100 flex items-center space-x-1.5">
              <span class="w-2 h-2 bg-slate-400 rounded-full dot-bounce"></span>
              <span class="w-2 h-2 bg-slate-400 rounded-full dot-bounce"></span>
              <span class="w-2 h-2 bg-slate-400 rounded-full dot-bounce"></span>
            </div>
          </div>
        </div>
      `;
      chatBox.insertAdjacentHTML("beforeend", indicator);
      scrollToBottom();
    }

    function removeTypingIndicator() {
      const indicator = document.getElementById("typing-indicator");
      if (indicator) indicator.remove();
    }

    // 힌트 패널에 추천 문장 설정하기
    function setHints(hints) {
      currentHints = hints;
      const container = document.getElementById("hint-buttons-container");
      container.innerHTML = "";

      hints.forEach(hint => {
        const btn = document.createElement("button");
        btn.className = "w-full text-left bg-white hover:bg-indigo-100 border border-indigo-100 px-3 py-2 rounded-xl text-xs text-slate-700 transition-colors flex flex-col space-y-0.5 shadow-sm";
        btn.onclick = () => {
          document.getElementById("user-input").value = hint.eng;
          toggleHintPanel(false); // 힌트 입력 시 패널 닫기
          document.getElementById("user-input").focus();
        };

        btn.innerHTML = `
          <span class="font-semibold text-indigo-700">${hint.eng}</span>
          <span class="text-[10px] text-slate-400">${hint.kor}</span>
        `;
        container.appendChild(btn);
      });
    }

    // 번역 온/오프
    function toggleTranslation(id) {
      const transDiv = document.getElementById(`trans-${id}`);
      if (transDiv) {
        transDiv.classList.toggle("hidden");
      }
    }

    // 힌트 패널 보이기/숨기기
    function toggleHintPanel(forceState) {
      const panel = document.getElementById("hint-panel");
      if (forceState !== undefined) {
        if (forceState) panel.classList.remove("hidden");
        else panel.classList.add("hidden");
      } else {
        panel.classList.toggle("hidden");
      }
    }

    // 전송 버튼 클릭 시 동작
    function sendMessage() {
      const input = document.getElementById("user-input");
      const text = input.value.trim();
      if (!text) return;

      // 1. 유저 메시지 화면 추가
      appendUserMessage(text);
      input.value = "";

      // 2. Sam의 답변 매칭 계산
      const reply = getSamResponse(text);

      // 3. 타이핑 효과 후 Sam의 답장
      showTypingIndicator();
      setTimeout(() => {
        removeTypingIndicator();
        appendSamMessage(reply.text, reply.translation);
        setHints(reply.hints);
      }, 1500);
    }

    // 유저의 입력 텍스트를 분석해 가장 적절한 답변 객체 리턴
    function getSamResponse(userText) {
      const lowerText = userText.toLowerCase();

      // 패턴 일치도 확인
      for (let scenario of responseScenarios) {
        // 유저 답변에 어떤 키워드라도 하나 걸려들면 해당 답변 리턴
        const match = scenario.keywords.some(keyword => lowerText.includes(keyword));
        if (match) {
          return scenario;
        }
      }

      // 일치하는 키워드가 없으면 무작위 답변 매칭
      const randomIdx = Math.floor(Math.random() * fallbackResponses.length);
      return fallbackResponses[randomIdx];
    }

    // 엔터키 입력 시 전송
    function handleKeyPress(event) {
      if (event.key === "Enter") {
        sendMessage();
      }
    }

    // 스크롤 최하단 자동 이동
    function scrollToBottom() {
      const chatBox = document.getElementById("chat-box");
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    // 대화 처음부터 다시 시작
    function resetChat() {
      if (confirm("Sam과의 대화를 새로 시작할까요?")) {
        initChat();
      }
    }

    // 위험 코드 필터링용 헬퍼 함수
    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
      );
    }

    // 웹앱 실행과 동시에 아이콘 및 대화 시작
    window.onload = () => {
      lucide.createIcons();
      initChat();
    };
  </script>
</body>
</html>
